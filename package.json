{
  "name": "t3-vscode",
  "displayName": "T3 VSCode",
  "description": "Alpha client for local T3 Code servers: workspace sessions, editor chat, rich messages and account usage.",
  "version": "0.1.19",
  "publisher": "hungtienhuang",
  "repository": {
    "type": "git",
    "url": "https://github.com/busFred/t3-vscode.git"
  },
  "private": true,
  "type": "module",
  "main": "./dist/extension.mjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "t3-sidebar",
          "title": "T3 VSCode",
          "icon": "resources/t3-icon.svg"
        }
      ]
    },
    "views": {
      "t3-sidebar": [
        {
          "type": "webview",
          "id": "t3.webview",
          "name": "T3 VSCode"
        }
      ]
    },
    "commands": [
      {
        "command": "t3-vscode.openInTab",
        "title": "Open New Chat in Editor Tab",
        "category": "T3 VSCode",
        "icon": "$(add)"
      },
      {
        "command": "t3-vscode.newThread",
        "title": "New Thread",
        "category": "T3 VSCode",
        "icon": "$(add)"
      },
      {
        "command": "t3-vscode.showUsage",
        "title": "Account & Usage",
        "category": "T3 VSCode",
        "icon": "$(graph)"
      },
      {
        "command": "t3-vscode.showThreads",
        "title": "Sessions",
        "category": "T3 VSCode",
        "icon": "$(history)"
      },
      {
        "command": "t3-vscode.threadActions",
        "title": "Thread Actions",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.pair",
        "title": "Pair with T3 Server",
        "category": "T3 VSCode",
        "icon": "$(plug)"
      },
      {
        "command": "t3-vscode.fontSettings",
        "title": "Font Settings",
        "category": "T3 VSCode",
        "icon": "$(text-size)"
      },
      {
        "command": "t3-vscode.insertReference",
        "title": "Reference Editor Selection",
        "category": "T3 VSCode"
      },
      {
        "command": "t3-vscode.reconnect",
        "title": "Reconnect to T3 Server",
        "category": "T3 VSCode",
        "icon": "$(refresh)"
      },
      {
        "command": "t3-vscode.openWebUi",
        "title": "Open Web UI",
        "category": "T3 VSCode",
        "icon": "$(globe)"
      },
      {
        "command": "t3-vscode.configureUsage",
        "title": "Configure Status Meters",
        "category": "T3 VSCode",
        "icon": "$(graph)"
      }
    ],
    "keybindings": [
      {
        "command": "t3-vscode.insertReference",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      },
      {
        "command": "t3-vscode.insertReference",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "t3-vscode.newThread",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "t3-vscode.insertReference",
          "when": "editorTextFocus",
          "group": "t3"
        }
      ],
      "view/title": [
        {
          "command": "t3-vscode.threadActions",
          "when": "view == t3.webview",
          "group": "1_thread"
        },
        {
          "command": "t3-vscode.fontSettings",
          "when": "view == t3.webview",
          "group": "3_appearance"
        },
        {
          "command": "t3-vscode.pair",
          "when": "view == t3.webview",
          "group": "2_connection"
        },
        {
          "command": "t3-vscode.openWebUi",
          "when": "view == t3.webview",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": [
      {
        "title": "Appearance",
        "order": 1,
        "properties": {
          "t3-vscode.fontSizeInterface": {
            "type": "integer",
            "default": 16,
            "minimum": 12,
            "maximum": 20,
            "scope": "window",
            "markdownDescription": "Base font size in pixels for T3 chat text, navigation and labels. Matches T3 Code's interface scaling. Changes apply immediately to the sidebar and all T3 editor tabs.",
            "order": 1
          },
          "t3-vscode.fontSizePrompt": {
            "type": "integer",
            "default": 14,
            "minimum": 12,
            "maximum": 20,
            "scope": "window",
            "description": "Font size in pixels for message and queued-message editors, independent of interface and code sizes. Changes apply immediately.",
            "order": 2
          },
          "t3-vscode.fontSizeCode": {
            "type": "integer",
            "default": 13,
            "minimum": 10,
            "maximum": 18,
            "scope": "window",
            "description": "Font size in pixels for code blocks, diffs and tool output, independent of interface and prompt sizes. Changes apply immediately.",
            "order": 3
          }
        }
      },
      {
        "title": "Reading",
        "order": 2,
        "properties": {
          "t3-vscode.messageNavigation": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "off"
            ],
            "enumDescriptions": [
              "Show the message rail on the left.",
              "Show the message rail on the right.",
              "Hide the message rail."
            ],
            "default": "left",
            "scope": "window",
            "description": "Placement of the message navigation rail in editor chats. Hover or scroll over it to preview prompts, then click to jump. Changes apply immediately.",
            "order": 1
          }
        }
      },
      {
        "title": "Usage",
        "order": 3,
        "properties": {
          "t3-vscode.usage.followActiveConversation": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "description": "Show the remaining subscription limits of the provider used by the focused conversation. Month, week and session appear in that order.",
            "order": 1
          },
          "t3-vscode.usage.pinnedAccounts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "window",
            "markdownDescription": "Accounts to keep in the status bar alongside the active conversation. Use [Configure Status Meters](command:t3-vscode.configureUsage) to choose accounts. Each account has its own meter; only reported quota windows are shown.",
            "order": 2
          },
          "t3-vscode.usage.refreshIntervalSeconds": {
            "type": "number",
            "default": 300,
            "minimum": 0,
            "scope": "window",
            "markdownDescription": "How often, in seconds, to refresh provider usage for the status bar meters while connected. Usage is also refreshed once when T3 VSCode connects. A refresh that falls due while a message is being sent or a response is running waits for the session to go idle, so it is far less likely to delay your messages; one is forced through once the meters are five intervals stale. Values from 1 to 14 are raised to 15; `0` disables periodic refresh. Changes apply immediately.",
            "order": 3
          }
        }
      },
      {
        "title": "Connection",
        "order": 4,
        "properties": {
          "t3-vscode.t3Home": {
            "type": "string",
            "default": "",
            "description": "T3 home directory (the server's data dir, default ~/.t3 or $T3CODE_HOME). Empty = auto. Change only to point at an isolated/dev server.",
            "order": 1
          }
        }
      }
    ],
    "icons": {
      "t3-vscode-codex": {
        "description": "T3 VSCode codex provider icon",
        "default": {
          "fontPath": "./resources/provider-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "t3-vscode-claude": {
        "description": "T3 VSCode claude provider icon",
        "default": {
          "fontPath": "./resources/provider-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "t3-vscode-kimi": {
        "description": "T3 VSCode kimi provider icon",
        "default": {
          "fontPath": "./resources/provider-icons.woff",
          "fontCharacter": "\\E003"
        }
      },
      "t3-vscode-other": {
        "description": "T3 VSCode other provider icon",
        "default": {
          "fontPath": "./resources/provider-icons.woff",
          "fontCharacter": "\\E004"
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run build:extension && pnpm run build:webview",
    "build:extension": "tsdown",
    "build:webview": "vite build && vite build -c vite.visuals.config.ts && node scripts/build-math.mjs",
    "build:spike": "tsdown -c tsdown.spike.config.ts",
    "spike": "pnpm run build:spike && node dist-spike/spike.mjs",
    "dev:extension": "tsdown --watch",
    "dev:webview": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build && node scripts/generate-notices.mjs",
    "package": "node scripts/package-vsix.mjs",
    "test": "tsx --test src/host/*.test.ts src/shared/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@legendapp/list": "3.3.5",
    "@pierre/diffs": "1.3.0-beta.10",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "effect": "4.0.0-rc.115",
    "katex": "0.16.25",
    "lucide-react": "0.564.0",
    "mermaid": "11.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vscode/vsce": "4.0.0",
    "micromark-util-types": "^2.0.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.22.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.0",
    "vite": "^6.3.3",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "icon": "resources/t3-extension.png",
  "preview": true,
  "license": "MIT",
  "homepage": "https://github.com/busFred/t3-vscode#readme",
  "bugs": {
    "url": "https://github.com/busFred/t3-vscode/issues"
  },
  "keywords": [
    "t3-code",
    "chat",
    "ai",
    "codex",
    "claude",
    "sessions",
    "latex"
  ]
}
