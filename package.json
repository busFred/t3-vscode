{
  "name": "t3-vscode",
  "displayName": "T3 Code",
  "description": "Thin VS Code client for a T3 Code server — chat with provider agents (Kimi via ACP registry, Codex, Claude, …) from the sidebar or an editor tab.",
  "version": "0.0.2",
  "publisher": "t3-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/busFred/t3-vscode.git"
  },
  "private": true,
  "type": "module",
  "main": "./dist/extension.mjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "t3-sidebar",
          "title": "T3 Code",
          "icon": "resources/t3-icon.svg"
        }
      ]
    },
    "views": {
      "t3-sidebar": [
        {
          "type": "webview",
          "id": "t3.webview",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "t3-vscode.openInTab",
        "title": "Open Chat in Editor Tab",
        "category": "T3",
        "icon": "$(link-external)"
      },
      {
        "command": "t3-vscode.newThread",
        "title": "New Thread",
        "category": "T3",
        "icon": "$(add)"
      },
      {
        "command": "t3-vscode.showThreads",
        "title": "Projects and Threads",
        "category": "T3",
        "icon": "$(list-tree)"
      },
      {
        "command": "t3-vscode.threadActions",
        "title": "Thread Actions",
        "category": "T3"
      },
      {
        "command": "t3-vscode.openInSideBar",
        "title": "Open Chat in Sidebar",
        "category": "T3",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "t3-vscode.pair",
        "title": "Pair with T3 Server",
        "category": "T3",
        "icon": "$(plug)"
      },
      {
        "command": "t3-vscode.reconnect",
        "title": "Reconnect to T3 Server",
        "category": "T3",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "t3-vscode.showThreads",
          "when": "view == t3.webview",
          "group": "navigation@0"
        },
        {
          "command": "t3-vscode.newThread",
          "when": "view == t3.webview",
          "group": "navigation@1"
        },
        {
          "command": "t3-vscode.openInTab",
          "when": "view == t3.webview",
          "group": "navigation@2"
        },
        {
          "command": "t3-vscode.threadActions",
          "when": "view == t3.webview",
          "group": "1_thread"
        },
        {
          "command": "t3-vscode.pair",
          "when": "view == t3.webview",
          "group": "2_connection"
        }
      ]
    },
    "configuration": {
      "title": "T3 Code",
      "properties": {
        "t3-vscode.t3Home": {
          "type": "string",
          "default": "",
          "description": "T3 home directory (the server's data dir, default ~/.t3 or $T3CODE_HOME). Empty = auto. Change only to point at an isolated/dev server."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run build:extension && pnpm run build:webview",
    "build:extension": "tsdown",
    "build:webview": "vite build",
    "build:spike": "tsdown -c tsdown.spike.config.ts",
    "spike": "pnpm run build:spike && node dist-spike/spike.mjs",
    "dev:extension": "tsdown --watch",
    "dev:webview": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build && node scripts/generate-notices.mjs",
    "package": "vsce package --no-dependencies --skip-license",
    "test": "tsx --test src/host/*.test.ts src/shared/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@legendapp/list": "3.3.5",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "clsx": "2.1.1",
    "effect": "4.0.0-rc.115",
    "lucide-react": "0.564.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vscode/vsce": "4.0.0",
    "micromark-util-types": "^2.0.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.22.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.0",
    "vite": "^6.3.3",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
